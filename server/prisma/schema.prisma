generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Global Tree to keep multiple trees separate
model Tree {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  persons     Person[]
  families    Family[]
  sources     Source[]
  repositories Repository[]
  notes       Note[]
  places      Place[]
  media       Media[]
}

model Person {
  id            String       @id @default(uuid())
  treeId        String
  sex           String?      // M/F/X/U
  restriction   String?      
  rin           String?      
  gedcomId      String?      // Cross-ref ID like @I1@
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tree          Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  names         Name[]
  events        Event[]      @relation("PersonEvents")
  facts         Fact[]
  attributes    Attribute[]
  associations  Association[] @relation("PersonAssociations")
  asAssociated  Association[] @relation("AssociatedPerson")
  sources       Citation[]
  mediaLinks    MediaLink[]
  noteLinks     NoteLink[]
  
  parentRelationships Relationship[] @relation("ChildToParent")
  childRelationships  Relationship[] @relation("ParentToChild")

  @@unique([treeId, gedcomId])
}

model Name {
  id         String   @id @default(uuid())
  personId   String
  value      String   
  type       String?  
  lang       String?  
  prefix     String?  
  given      String?  
  surname    String?  
  surPrefix  String?  
  suffix     String?  
  nick       String?  
  isPrimary  Boolean  @default(false)

  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  sources    Citation[]
  notes      NoteLink[]
}

model Event {
  id          String   @id @default(uuid())
  personId    String?  
  familyId    String?  
  type        String   // BIRT, DEAT, MARR...
  date        Json?    // { modifier, value, phrase }
  dateText    String?  // Original/Display text
  placeId     String?  
  address     Json?    
  cause       String?  
  age         String?  
  description String?  

  person      Person?  @relation("PersonEvents", fields: [personId], references: [id], onDelete: Cascade)
  family      Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  place       Place?   @relation(fields: [placeId], references: [id])
  sources     Citation[]
  notes       NoteLink[]
  media       MediaLink[]
}

model Fact {
  id          String   @id @default(uuid())
  personId    String
  type        String   
  value       String?  
  date        Json?    
  dateText    String?
  placeId     String?
  description String?

  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  place       Place?   @relation(fields: [placeId], references: [id])
  sources     Citation[]
  notes       NoteLink[]
  media       MediaLink[]
}

model Family {
  id          String   @id @default(uuid())
  treeId      String
  gedcomId    String?  
  type        String?  
  rin         String?

  tree          Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  events        Event[]
  sources       Citation[]
  noteLinks     NoteLink[]
  mediaLinks    MediaLink[]
  relationships Relationship[]

  @@unique([treeId, gedcomId])
}

model Relationship {
  id             String   @id @default(uuid())
  childId        String?  
  parentId       String?  
  familyId       String?  
  type           String   // parent, spouse, partner
  role           String?  // husband, wife, child
  status         String?  

  child          Person?  @relation("ChildToParent", fields: [childId], references: [id], onDelete: Cascade)
  parent         Person?  @relation("ParentToChild", fields: [parentId], references: [id], onDelete: Cascade)
  family         Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  noteLinks      NoteLink[]

  @@unique([childId, parentId, type])
}

model Place {
  id          String   @id @default(uuid())
  treeId      String
  name        String   
  hierarchy   Json?    
  latitude    Float?
  longitude   Float?   
  jurisdiction String?  

  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  events      Event[]
  facts       Fact[]
  noteLinks   NoteLink[]

  @@unique([treeId, name])
}

model Source {
  id          String   @id @default(uuid())
  treeId      String
  gedcomId    String?
  title       String
  author      String?
  publication String?
  repositoryId String?
  quality     String?  

  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  citations   Citation[]
  noteLinks   NoteLink[]
  mediaLinks  MediaLink[]
  repository  Repository? @relation(fields: [repositoryId], references: [id])

  @@unique([treeId, gedcomId])
}

model Citation {
  id          String   @id @default(uuid())
  sourceId    String
  personId    String?
  eventId     String?
  factId      String?
  nameId      String?
  familyId    String?
  page        String?  
  quality     String?  
  text        String?  

  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  person      Person?  @relation(fields: [personId], references: [id])
  event       Event?   @relation(fields: [eventId], references: [id])
  fact        Fact?    @relation(fields: [factId], references: [id])
  name        Name?    @relation(fields: [nameId], references: [id])
  family      Family?  @relation(fields: [familyId], references: [id])
}

model Repository {
  id          String   @id @default(uuid())
  treeId      String
  name        String
  address     Json?    

  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  sources     Source[]
}

model Media {
  id          String   @id @default(uuid())
  treeId      String
  url               String   
  format            String?  
  title             String?
  originalFileName  String?
  sha256            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  links       MediaLink[]
  noteLinks   NoteLink[]
}

model MediaLink {
  id          String   @id @default(uuid())
  mediaId     String
  personId    String?
  eventId     String?
  factId      String?
  sourceId    String?
  familyId    String?
  isPrimary   Boolean  @default(false)

  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person      Person?  @relation(fields: [personId], references: [id])
  event       Event?   @relation(fields: [eventId], references: [id])
  fact        Fact?    @relation(fields: [factId], references: [id])
  source      Source?  @relation(fields: [sourceId], references: [id])
  family      Family?  @relation(fields: [familyId], references: [id])
}

model Note {
  id          String   @id @default(uuid())
  treeId      String
  text        String

  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  links       NoteLink[]
}

model NoteLink {
  id            String    @id @default(uuid())
  noteId        String
  personId      String?
  eventId       String?
  factId        String?
  nameId        String?
  placeId       String?
  sourceId      String?
  mediaId       String?
  familyId      String?
  relationshipId String?

  note          Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  person        Person?   @relation(fields: [personId], references: [id])
  event         Event?    @relation(fields: [eventId], references: [id])
  fact          Fact?     @relation(fields: [factId], references: [id])
  name          Name?     @relation(fields: [nameId], references: [id])
  place         Place?    @relation(fields: [placeId], references: [id])
  source        Source?   @relation(fields: [sourceId], references: [id])
  media         Media?    @relation(fields: [mediaId], references: [id])
  family        Family?   @relation(fields: [familyId], references: [id])
  relationship  Relationship? @relation(fields: [relationshipId], references: [id])
}

model Association {
  id          String   @id @default(uuid())
  personId    String
  associatedPersonId String
  relation    String   

  person      Person   @relation("PersonAssociations", fields: [personId], references: [id], onDelete: Cascade)
  associated  Person   @relation("AssociatedPerson", fields: [associatedPersonId], references: [id])
}

model Attribute {
  id          String   @id @default(uuid())
  personId    String
  type        String   
  value       Json?    

  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  createdAt   DateTime @default(now())
}
