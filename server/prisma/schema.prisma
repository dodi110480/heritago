generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum GlobalRole {
  ADMIN
  USER
  GUEST
}

enum TreeAccessLevel {
  OWNER
  EDITOR
  VIEWER
  COMMENTER
}

enum Sex {
  M
  F
  X
  U
}

enum PrivacyLevel {
  PUBLIC
  FAMILY
  PRIVATE
}

enum FamilyRole {
  SPOUSE
  CHILD
  PARENT
}

enum MarriageType {
  CIVIL
  RELIGIOUS
  COMMON_LAW
  SAME_SEX
  UNKNOWN
}

enum PedigreeType {
  BIRTH
  ADOPTED
  FOSTER
  STEP
  SEALED
}

enum DatePrecision {
  EXACT
  ABOUT
  CALCULATED
  BEFORE
  AFTER
  BETWEEN
  RANGE
}

enum ConfidenceLevel {
  CERTAIN
  VERY_LIKELY
  LIKELY
  POSSIBLE
  UNLIKELY
}

enum ResearchStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum DnaTestProvider {
  ANCESTRY
  MYHERITAGE
  GEDMATCH
  TWENTY_THREE_AND_ME
  FAMILY_TREE_DNA
  LIVING_DNA
}

enum NameType {
  BIRTH // Geburtsname
  MARRIED // Ehename
  ALSO_KNOWN_AS // Alias / Künstlername
  IMMIGRANT // Name nach Einwanderung
  MAIDEN // Mädchenname
  OTHER // Sonstiges
}

enum RestrictionNotice {
  CONFIDENTIAL
  LOCKED
  PRIVACY
  NONE
}

enum AssociationRole {
  GODPARENT
  WITNESS
  CLERGY
  INFORMANT
  EMPLOYER
  FRIEND
  OTHER
}

enum EntityType {
  PERSON
  FAMILY
  EVENT
  FACT
  SOURCE
  REPOSITORY
  MEDIA
  NOTE
  PLACE
  SUBMITTER
  CITATION
  OTHER
  ADDRESS
}

enum EventType {
  BIRT // Geburt
  CHR // Taufe (religiös)
  BAPM // Taufe (nicht-religiös)
  DEAT // Tod
  BURI // Beerdigung
  CREM // Einäscherung
  MARR // Heirat
  DIV // Scheidung
  ANUL // Annulierung
  ENGA // Verlobung
  ADOP // Adoption
  BARM // Bar Mitzvah
  BASM // Bas Mitzvah
  BLES // Segen
  CHRA // Erwachsentaufe
  CONF // Firmung/Konfirmation
  FCOM // Erste Kommunion
  ORDN // Ordination
  NATU // Einbürgerung
  EMIG // Auswanderung
  IMMI // Einwanderung
  CENS // Volkszählung
  PROB // Testamentseröffnung
  WILL // Testament
  GRAD // Abschluss
  RETI // Ruhestand
  EVEN // Allgemeines Ereignis
  BAPL // LDS-Taufe (für Verstorbene)
  CONL // LDS-Bestätigung
  ENDL // LDS-Investitur (ersetzt ENDO)
  SLGC // LDS-Kindersiegelung
  SLGS // LDS-Stellvertreter-Siegelung
  RESI // Wohnsitz
  MILI // Militärdienst
  CAST // Kaste
  DSCR // Körperliche Beschreibung
  OTHER // Sonstiges (für _CUSTOM)
}

enum FactType {
  OCCUPATION
  EDUCATION
  RELIGION
  NATIONALITY
  TITLE
  RESIDENCE
  PROPERTY
  MILITARY_SERVICE
  DESCRIPTION
  OTHER
}

enum PlaceLevel {
  // Von kleinster zu größter Einheit
  BUILDING    // Gebäude (z. B. "Rathaus München")
  STREET      // Straße (z. B. "Marienplatz")
  DISTRICT    // Stadtviertel/Bezirk (z. B. "Altstadt-Lehel")
  CITY        // Stadt/Gemeinde (z. B. "München")
  MUNICIPALITY // Gemeindeverband (z. B. "Landkreis München")
  REGION      // Region (z. B. "Oberbayern")
  STATE       // Bundesland (z. B. "Bayern")
  COUNTRY     // Land (z. B. "Deutschland")
  CONTINENT   // Kontinent (z. B. "Europa")
}

//////////////////////////////////////////////////
// TREE
//////////////////////////////////////////////////

model Tree {
  id          String  @id @default(uuid())
  name        String  @unique
  title       String? // TITL
  publication String? // PUBL
  author      String? // AUTH
  description String?
  isPublic    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chanDate  DateTime?

  // GEDCOM 7.0 Header Infos
  gedcomVersion  String?
  sourceSoftware String?
  copyright      String?
  language       String?
  placForm       String?

  // Additional Header attributes
  exportDate  DateTime? // HEAD.DATE + TIME
  fileName    String? // HEAD.FILE
  destination String? // HEAD.DEST
  sourceName  String? // HEAD.SOUR.NAME
  sourceVers  String? // HEAD.SOUR.VERS
  sourceData  String? // HEAD.SOUR.DATA

  // Custom Extensions (SCHMA, _CUSTOM)
  extensions       Json?
  schemaExtensions Json? // SCHMA-Definition

  headerMedia MediaLink[] @relation("TreeHeaderMedia") // HEAD.OBJE

  persons      Person[]
  families     Family[]
  names        Name[]
  events       Event[]
  facts        Fact[]
  sources      Source[]
  repositories Repository[]
  media        Media[]
  citations    Citation[]
  noteLinks    NoteLink[]
  mediaLinks   MediaLink[]
  associations Association[]
  dnaMatches   DnaMatch[]
  dnaSegments  DnaSegment[]
  sharedNotes  SharedNote[]
  places       Place[]
  researchLogs ResearchLog[]
  changeLogs   ChangeLog[]
  permissions  TreePermission[]
  imports      Import[]

  submissions    Submission[]
  communications Communication[]

  submitters  Submitter[]
  identifiers Identifier[]

  @@index([isPublic])
}

//////////////////////////////////////////////////
// USER & PERMISSIONS
//////////////////////////////////////////////////

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  email      String     @unique
  password   String?
  globalRole GlobalRole @default(USER)

  isEmailVerified  Boolean @default(false)
  verificationCode String?

  permissions  TreePermission[]
  researchLogs ResearchLog[]
  changeLogs   ChangeLog[]

  // Neue Relationen für Communication
  sentCommunications     Communication[] @relation("SentCommunications")
  receivedCommunications Communication[] @relation("ReceivedCommunications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media[]
  notes     SharedNote[] @relation("NoteAuthor")
}

model TreePermission {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level           TreeAccessLevel
  privacyOverride Boolean?

  @@unique([treeId, userId])
  @@index([treeId])
}

//////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////

model Person {
  id                String            @id @default(uuid())
  gedcomId          String?
  sex               Sex?
  isLiving          Boolean           @default(false)
  privacyLevel      PrivacyLevel      @default(PRIVATE)
  restrictionNotice RestrictionNotice @default(NONE)
  exid              String?
  www               String[]
  religion          String?
  notes             SharedNote[]
  addresses         Address[]

  submissions Submission[]

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  names         Name[]
  events        Event[]        @relation("PersonEvents")
  facts         Fact[]         @relation("PersonFacts")
  familyMembers FamilyMember[]

  associations   Association[] @relation("PersonAssociations")
  associatedWith Association[] @relation("AssociatedPerson")

  mediaLinks  MediaLink[]
  noteLinks   NoteLink[]
  citations   Citation[]
  identifiers Identifier[]

  dnaMatches   DnaMatch[]   @relation("PersonDnaMatches")
  dnaMatchedBy DnaMatch[]   @relation("PersonDnaMatchCounterparty")
  dnaSegments  DnaSegment[] @relation("PersonDnaSegments")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chanDate          DateTime?
  eventParticipants EventParticipant[]
  extensions        Json?

  @@unique([treeId, gedcomId])
  @@index([treeId])
  @@index([treeId, isLiving])
  @@index([sex])
  @@index([importId])
  @@index([gedcomId])
}

//////////////////////////////////////////////////
// FAMILY
//////////////////////////////////////////////////

model Family {
  id       String  @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  importId          String?
  import            Import?           @relation(fields: [importId], references: [id], onDelete: SetNull)
  restrictionNotice RestrictionNotice @default(NONE)
  childCount        Int?

  familyMembers FamilyMember[]
  events        Event[]        @relation("FamilyEvents")
  eventsLdsFamc Event[]        @relation("LdsFamilyEvents") // LDS relation
  facts         Fact[]         @relation("FamilyFacts")

  mediaLinks  MediaLink[]
  noteLinks   NoteLink[]
  citations   Citation[]
  identifiers Identifier[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chanDate   DateTime?
  extensions Json?

  associations Association[]

  @@unique([treeId, gedcomId])
  @@index([treeId])
  @@index([importId])
  @@index([gedcomId])
}

//////////////////////////////////////////////////
// FAMILY MEMBER
//////////////////////////////////////////////////

model FamilyMember {
  id       String @id @default(uuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  role         FamilyRole?
  marriageType MarriageType?
  pedigreeType PedigreeType?
  sortOrder    Int           @default(0)

  @@unique([familyId, personId])
  @@index([familyId])
  @@index([personId])
  @@index([familyId, role])
}

//////////////////////////////////////////////////
// NAME
//////////////////////////////////////////////////

model Name {
  id String @id @default(uuid())

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  full      String
  given     String?
  surname   String?
  prefix    String?
  suffix    String?
  type      NameType?
  religion  String?
  isPrimary Boolean   @default(true)
  sortOrder Int       @default(0)

  validity NameValidity[]

  @@index([treeId])
  @@index([treeId, surname, given])
  @@index([treeId, isPrimary])
  @@unique([personId, full, type, isPrimary])
}

//////////////////////////////////////////////////
// EVENT
//////////////////////////////////////////////////

model Event {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  type         EventType
  eventSubtype String?

  dateText  String?
  dateStart DateTime?
  dateEnd   DateTime?
  dateType  DatePrecision?

  sortDate  DateTime?
  sortOrder Int       @default(0)

  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  description String?
  isNegative  Boolean @default(false)
  customType  String? // Für nicht-standardisierte GEDCOM-Tags (_CUSTOM)
  cause       String?
  age         String?
  ldsFamcId   String?
  ldsFamc     Family? @relation("LdsFamilyEvents", fields: [ldsFamcId], references: [id], onDelete: SetNull)

  minDate DateTime? // Hilfsfeld für Sortierung/Filterung
  maxDate DateTime? // Hilfsfeld für Sortierung/Filterung

  personId String?
  person   Person? @relation("PersonEvents", fields: [personId], references: [id], onDelete: SetNull)

  familyId String?
  family   Family? @relation("FamilyEvents", fields: [familyId], references: [id], onDelete: SetNull)

  // LDS-Specific fields (Optional)
  ldsTemple String? // TEMP – Temple-Code
  ldsStatus String? // STAT – z. B. Completed, Child
  // ldsFamcId    String?     // FAMC – Family für Sealing - This was duplicated, removed.
  // ldsFamc      Family?     @relation("FamilyLdsSealing", fields: [ldsFamcId], references: [id], onDelete: SetNull) - This was duplicated, removed.

  citations    Citation[]
  mediaLinks   MediaLink[]
  noteLinks    NoteLink[]
  associations Association[]
  participants EventParticipant[]
  extensions   Json?
  sourceEvents SourceEvent[]

  @@index([treeId])
  @@index([treeId, sortDate])
  @@index([treeId, type, sortDate])
  @@index([importId])
  @@unique([personId, familyId, type, dateText, placeId, description])
}

//////////////////////////////////////////////////
// FACT
//////////////////////////////////////////////////

model Fact {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  type FactType

  value     String?
  dateText  String?
  dateStart DateTime?
  dateEnd   DateTime?
  dateType  DatePrecision?

  sortOrder  Int     @default(0)
  customType String? // Für nicht-standardisierte GEDCOM-Tags

  minDate DateTime? // Hilfsfeld für Sortierung/Filterung
  maxDate DateTime? // Hilfsfeld für Sortierung/Filterung

  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation("PersonFacts", fields: [personId], references: [id], onDelete: SetNull)

  familyId String?
  family   Family? @relation("FamilyFacts", fields: [familyId], references: [id], onDelete: SetNull)

  citations  Citation[]
  mediaLinks MediaLink[]
  noteLinks  NoteLink[]
  associations Association[]
  extensions Json?

  @@index([treeId])
  @@index([treeId, type])
  @@unique([personId, familyId, type, value, dateText, placeId])
}

//////////////////////////////////////////////////
// PLACE
//////////////////////////////////////////////////

model Place {
  id            String   @id @default(uuid())
  treeId        String
  tree          Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  name          String // Haupt-Name (PLAC Payload)
  form          String? // FORM – z. B. "Stadt,Gemeinde,Landkreis,Bundesland,Land" (Komma-separiert)
  jurisdiction  String? // dein bestehendes Feld – kann mit FORM harmonisiert werden
  historicNames String[] // dein Array – gut als Fallback

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  latitude  Float?
  longitude Float?
  parentId  String?
  parent    Place?  @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Place[] @relation("PlaceHierarchy")
  phrase    String? // PHRASE – z. B. "historisch: Monachium"
  level PlaceLevel @default(CITY) // Standardmäßig "Stadt"
  
  // ── GEDCOM 7.0 Ergänzungen ───────────────────────────────────────────────────
  lang String? // Sprache des name (ISO 639)

  // Mehrsprachige Übersetzungen (TRAN + LANG)
  translations PlaceTranslation[]

  // Externe IDs (EXID)
  identifiers Identifier[]

  // Notizen direkt oder über NoteLink
  noteLinks NoteLink[] // erweitere NoteLink ggf. um placeId, falls noch nicht da

  events       Event[]
  facts        Fact[]
  associations Association[]
  sourceEvents SourceEvent[]

  formTemplate String? // z. B. "$CITY, $STAE, $CTRY"

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chanDate   DateTime?
  extensions Json?

  @@unique([treeId, name, parentId]) // dein Unique bleibt
  @@index([treeId])
  @@index([treeId, name])
  @@index([latitude, longitude])
  @@index([importId])
}

model PlaceTranslation {
  id        String         @id @default(uuid())
  placeId   String
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String
  form      String?
  lang      String
  dateStart DateTime? // Gültig ab
  dateEnd   DateTime? // Gültig bis
  dateType  DatePrecision? // Präzision

  @@index([placeId])
}

model Identifier {
  id         String     @id @default(uuid())
  treeId     String
  tree       Tree       @relation(fields: [treeId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String // Verweis auf Person, Place, etc. (lose Verknüpfung)
  value      String // Der eigentliche Identifier-Wert
  type       String? // Typ des Identifiers (z.B. "wikidata", "social_security")

  // Optionale Relationen für Prisma-Navigation (vorteilhaft für Queries)
  personId     String?
  person       Person?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  placeId      String?
  place        Place?      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  sourceId     String?
  source       Source?     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citationId   String?
  citation     Citation?   @relation(fields: [citationId], references: [id], onDelete: Cascade)
  familyId     String?
  family       Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  mediaId      String?
  media        Media?      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  submitterId  String?
  submitter    Submitter?  @relation(fields: [submitterId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([entityId])
  @@index([value])
}

//////////////////////////////////////////////////
// SOURCE / REPOSITORY
//////////////////////////////////////////////////

model Source {
  id       String  @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  title       String
  shortTitle  String?
  author      String?
  publication String?

  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  sourceType  String? // e.g. 'BUCH', 'WEBSEITE'
  category    String? // e.g. 'PRIMARY', 'SECONDARY'

  citations   Citation[]
  mediaLinks  MediaLink[]
  noteLinks   NoteLink[]
  identifiers Identifier[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chanDate     DateTime?
  extensions   Json?
  sourceEvents SourceEvent[]

  @@unique([treeId, gedcomId])
  @@index([treeId])
  @@index([importId])
  @@index([gedcomId])
}

model Repository {
  id       String  @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  callNumbers String[]

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  name    String
  address String?
  phone   String?
  email   String?
  website String?

  sources Source[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chanDate    DateTime?
  extensions  Json?
  identifiers Identifier[]

  @@index([treeId])
  @@index([importId])
  @@index([gedcomId])
}

//////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////

model Media {
  id       String  @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  title      String?
  path       String? // Relativer Pfad: users/{userid}/originals/v1/{uuid}.{ext}
  remoteUrl  String?
  mimeType   String?
  mediaType  String?
  filesize   Int?    // Umbenannt von fileSize
  dimensions String?

  version    Int     @default(1)
  isCurrent  Boolean @default(true)
  checksumSha256 String?

  cropX      Int?
  cropY      Int?
  cropWidth  Int?
  cropHeight Int?

  sortOrder Int @default(0)

  links       MediaLink[]
  citations   Citation[]
  noteLinks   NoteLink[]
  variants    MediaVariant[]
  identifiers Identifier[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chanDate   DateTime?
  extensions Json?

  fileFormat String? // z. B. "jpg", "pdf", "tiff"

  @@index([treeId])
  @@index([importId])
  @@index([gedcomId])
  @@index([userId])
  @@index([isCurrent])
}

//////////////////////////////////////////////////
// CITATION
//////////////////////////////////////////////////

model Citation {
  id       String @id @default(uuid())
  treeId   String
  tree     Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // ── Deine ursprünglichen Felder bleiben exakt so ───────────────────────────────
  page       String? // PAGE – Fundstelle
  dateText   String? // altes Datum-Feld (Fallback / Kompatibilität)
  confidence ConfidenceLevel? // dein bestehendes Confidence-Enum

  // ── GEDCOM 7.0 Ergänzungen (die wirklich nützlich sind) ────────────────────────
  quay Int? // QUAY 0–3 (direkt aus GEDCOM, für Export)

  // DATA Block
  dataDateText  String? // DATA.DATE – Datum wie in der Quelle
  dataDateStart DateTime?
  dataDateEnd   DateTime?
  dataDateType  DatePrecision? // optional: Präzision für dataDateText

  minDate DateTime? // Hilfsfeld für Sortierung/Filterung
  maxDate DateTime? // Hilfsfeld für Sortierung/Filterung

  // EVEN Block (welches Ereignis deckt die Quelle ab?)
  evenType       String? // EVEN (z. B. "BIRT", "CENS", "OCCU", "MARR" ...)
  evenPhrase     String? // EVEN PHRASE – wenn kein Enum passt
  evenRole       String? // ROLE (z. B. "CHIL", "HUSB", "WIFE", "WITN" ...)
  evenRolePhrase String? // ROLE PHRASE

  // Transkription / Abstract / wörtliches Zitat (sehr wichtig in GEDCOM 7!)
  citationTexts CitationText[] // 1:n → DATA.TEXT {0:M}

  // Externe IDs (Ancestry Citation ID, FamilySearch, Archiv-Signatur ...)
  identifiers Identifier[]

  // Direkte Medien/Scans genau zu diesem Beleg (nicht nur zur Quelle)
  // → nutzt dein bestehendes MediaLink-Modell (muss ggf. um citationId erweitert werden)
  mediaLinks MediaLink[]

  // Notes → nutzt dein bestehendes NoteLink-Modell (ggf. um citationId erweitern)
  noteLinks NoteLink[]

  // ── Deine polymorphe Verknüpfung (Person / Familie / Ereignis / Fakt / ...) ───
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  factId String?
  fact   Fact?   @relation(fields: [factId], references: [id], onDelete: SetNull)

  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  noteId String?
  note   SharedNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)

  // ── Zeitstempel (wie bei dir) ──────────────────────────────────────────────────
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chanDate   DateTime?
  extensions Json?

  // ── Deine ursprünglichen Indizes – 1:1 übernommen ──────────────────────────────
  @@index([treeId])
  @@index([sourceId])
  @@index([evenType])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([factId])
  @@index([mediaId])
  @@index([noteId])
  @@index([associationId])
}

// Für DATA.TEXT {0:M}
model CitationText {
  id         String   @id @default(uuid())
  citationId String
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  text String
  mime String? // z. B. "text/plain", "text/html"
  lang String? // z. B. "de", "en"

  @@index([citationId])
}

//////////////////////////////////////////////////
// SHARED NOTE
//////////////////////////////////////////////////

model SharedNote {
  id       String  @id @default(uuid())
  gedcomId String?
  treeId   String
  tree     Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)

  text           String
  lines          String[] // CONT-Zeilen für mehrzeilige Notes / formatiert
  mime           String?
  noteType       String?
  privacyLevel   PrivacyLevel   @default(PRIVATE)
  researchStatus ResearchStatus @default(OPEN)
  sortOrder      Int            @default(0)

  links      NoteLink[]
  citations  Citation[]
  mediaLinks MediaLink[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chanDate   DateTime?
  extensions Json?
  person     Person?   @relation(fields: [personId], references: [id])
  personId   String?

  userId     String?
  createdBy  User?     @relation(name: "NoteAuthor", fields: [userId], references: [id], onDelete: SetNull)


  @@index([treeId])
  @@index([treeId, researchStatus])
  @@index([treeId, noteType])
  @@index([importId])
  @@index([gedcomId])
}

//////////////////////////////////////////////////
// NOTE LINK
//////////////////////////////////////////////////

model NoteLink {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  noteId String
  note   SharedNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  personId    String?
  familyId    String?
  eventId     String?
  sourceId    String?
  mediaId     String?
  factId      String?
  submitterId String? // NEU

  person    Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  family    Family?    @relation(fields: [familyId], references: [id], onDelete: SetNull)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  source    Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  media     Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  fact      Fact?      @relation(fields: [factId], references: [id], onDelete: SetNull)
  submitter Submitter? @relation(fields: [submitterId], references: [id], onDelete: SetNull) // NEU

  context    String?
  isPrimary  Boolean   @default(false)
  sortOrder  Int       @default(0)
  placeId    String?
  place      Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  citationId String?
  citation   Citation? @relation(fields: [citationId], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([noteId])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([sourceId])
  @@index([mediaId])
  @@index([placeId])
  @@index([citationId])
  @@index([submitterId])
}

//////////////////////////////////////////////////
// MEDIA LINK
//////////////////////////////////////////////////

model MediaLink {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  headerTreeId String?
  headerTree   Tree?   @relation("TreeHeaderMedia", fields: [headerTreeId], references: [id], onDelete: SetNull)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  personId        String?
  familyId        String?
  eventId         String?
  sourceId        String?
  noteId          String?
  submitterId     String?
  communicationId String?
  factId          String?

  person        Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  source        Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  note          SharedNote?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  fact          Fact?          @relation(fields: [factId], references: [id], onDelete: SetNull)
  submitter     Submitter?     @relation(fields: [submitterId], references: [id], onDelete: SetNull) // NEU

  role      String?
  caption   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  citationId String?
  citation   Citation? @relation(fields: [citationId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([sourceId])
  @@index([noteId])
  @@index([citationId])
  @@index([submitterId])
  @@index([headerTreeId])
}

//////////////////////////////////////////////////
// ASSOCIATION
//////////////////////////////////////////////////

model Association {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId           String?
  familyId           String?
  associatedPersonId String?
  person             Person? @relation("PersonAssociations", fields: [personId], references: [id], onDelete: Cascade)
  family             Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  associated         Person? @relation("AssociatedPerson", fields: [associatedPersonId], references: [id], onDelete: Cascade)

  role         AssociationRole  @default(OTHER)
  relationText String?
  rolePhrase   String? // RELA-PHRASE (freier Text zur Rolle)
  dateText     String?
  confidence   ConfidenceLevel?
  notes        String?

  eventId String?
  factId  String?
  placeId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fact    Fact?   @relation(fields: [factId], references: [id], onDelete: SetNull)
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  citations Citation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, personId, familyId, associatedPersonId, role, eventId, factId])
  @@index([treeId])
  @@index([personId])
  @@index([associatedPersonId])
  @@index([eventId])
  @@index([factId])
  @@index([placeId])
}

//////////////////////////////////////////////////
// DNA
//////////////////////////////////////////////////

model DnaMatch {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId      String
  matchPersonId String?
  person        Person  @relation("PersonDnaMatches", fields: [personId], references: [id], onDelete: Cascade)
  matchPerson   Person? @relation("PersonDnaMatchCounterparty", fields: [matchPersonId], references: [id], onDelete: SetNull)

  provider              DnaTestProvider?
  totalCm               Float?
  largestSegmentCm      Float?
  segmentCount          Int?
  predictedRelationship String?
  confidence            ConfidenceLevel?
  testDate              DateTime?
  kitId                 String?

  segments DnaSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, personId, matchPersonId, provider])
  @@index([treeId])
  @@index([personId, confidence])
  @@index([matchPersonId])
  @@index([treeId, provider])
}

model DnaSegment {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation("PersonDnaSegments", fields: [personId], references: [id], onDelete: Cascade)

  matchId String?
  match   DnaMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  chromosome     String
  startPosition  Int
  endPosition    Int
  cm             Float
  snpCount       Int?
  provider       DnaTestProvider?
  build          String?
  isTriangulated Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([treeId, chromosome])
  @@index([personId])
  @@index([matchId])
}

//////////////////////////////////////////////////
// RESEARCH / CHANGE LOG
//////////////////////////////////////////////////

model ResearchLog {
  id     String  @id @default(uuid())
  treeId String
  tree   Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status      ResearchStatus @default(OPEN)
  title       String
  description String?
  objective   String?
  result      String?
  nextStep    String?

  entityType  EntityType?
  entityId    String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treeId])
  @@index([userId])
  @@index([entityType, entityId])
}

model ChangeLog {
  id     String  @id @default(uuid())
  treeId String
  tree   Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     ChangeAction
  entityType EntityType
  entityId   String
  before     Json?
  after      Json?
  summary    String?
  reason     String?
  source     String?
  createdAt  DateTime     @default(now())

  @@index([treeId, createdAt])
  @@index([treeId, action])
  @@index([entityType, entityId])
  @@index([userId])
}

model NameValidity {
  id String @id @default(uuid())

  nameId String
  name   Name   @relation(fields: [nameId], references: [id], onDelete: Cascade)

  dateStart DateTime?
  dateEnd   DateTime?
  dateType  DatePrecision?

  minDate DateTime? // Hilfsfeld für Sortierung/Filterung
  maxDate DateTime? // Hilfsfeld für Sortierung/Filterung

  @@index([nameId])
}

model EventParticipant {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  role AssociationRole?

  @@index([eventId])
  @@index([personId])
}

//////////////////////////////////////////////////
// SUBMITTER
//////////////////////////////////////////////////

model Submitter {
  id       String  @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  name String

  // Vollständige Adresse (GEDCOM ADDR)
  addrStreet  String?
  addrCity    String?
  addrState   String?
  addrPostal  String?
  addrCountry String?

  phone String[]
  email String[]
  fax   String[]
  www   String[]

  language String?

  chanDate    DateTime?
  noteLinks   NoteLink[] // für Notizen am Submitter
  addresses   Address[]
  mediaLinks  MediaLink[] // falls SUBM Objekte hat
  extensions  Json?
  identifiers Identifier[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@index([treeId])
  @@index([gedcomId])
}

model MediaVariant {
  id       String  @id @default(uuid())
  mediaId  String
  path     String? // Umbenannt von filePath
  mimeType String?
  variant  String?
  media    Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

//////////////////////////////////////////////////
// GEDCOM IMPORT ENGINE (TEMPORARY TABLES & METADATA)
//////////////////////////////////////////////////

model Import {
  id String @id @default(uuid())

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  filename String
  source   String? // e.g. "GEDCOM", "CSV", "API"

  personCount Int?
  familyCount Int?
  eventCount  Int?

  createdAt DateTime @default(now())

  persons            Person[]
  families           Family[]
  events             Event[]
  places             Place[]
  sources            Source[]
  repositories       Repository[]
  media              Media[]
  sharedNotes        SharedNote[]
  importPersons      ImportPerson[]
  importFamilies     ImportFamily[]
  importEvents       ImportEvent[]
  importSources      ImportSource[]
  importSubmitters   ImportSubmitter[]
  importRepositories ImportRepository[]
  importMedia        ImportMedia[]
  importSharedNotes  ImportSharedNote[]

  @@index([treeId])
}

model ImportPerson {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportFamily {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportEvent {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportSource {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportSubmitter {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportRepository {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportMedia {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model ImportSharedNote {
  id     String @id @default(uuid())
  treeId String

  importId String?
  import   Import? @relation(fields: [importId], references: [id], onDelete: Cascade)

  gedcomXref String
  rawJson    Json

  createdAt DateTime @default(now())

  @@index([treeId])
  @@index([importId])
  @@index([treeId, gedcomXref])
}

model GedcomXrefMap {
  id     String @id @default(uuid())
  treeId String

  xref       String // e.g. "@I123@"
  entityType EntityType // e.g. PERSON, FAMILY, SOURCE
  entityId   String // e.g. the UUID of the Person

  createdAt DateTime @default(now())

  @@unique([treeId, xref, entityType])
  @@index([treeId])
  @@index([xref])
}

model Address {
  id        String  @id @default(uuid())
  street    String?
  city      String?
  state     String?
  postal    String?
  country   String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  submitterId String?
  submitter   Submitter? @relation(fields: [submitterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id          String    @id @default(uuid())
  treeId      String
  tree        Tree      @relation(fields: [treeId], references: [id])
  submitterId String
  submitter   Submitter @relation(fields: [submitterId], references: [id])
  date        DateTime
  notes       String?
  extensions  Json?
  person      Person?   @relation(fields: [personId], references: [id])
  personId    String?

  @@index([treeId])
  @@index([submitterId])
}

model Communication {
  id          String      @id @default(uuid())
  treeId      String
  tree        Tree        @relation(fields: [treeId], references: [id])
  senderId    String
  sender      User        @relation("SentCommunications", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?       @relation("ReceivedCommunications", fields: [recipientId], references: [id])
  subject     String
  body        String
  date        DateTime
  mediaLinks  MediaLink[]
  extensions  Json?

  @@index([treeId])
  @@index([senderId])
}

model SourceEvent {
  sourceId String
  source   Source  @relation(fields: [sourceId], references: [id])
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id])
  role     String? // z. B. "CHIL", "HUSB"
  place    Place?  @relation(fields: [placeId], references: [id])
  placeId  String?

  @@id([sourceId, eventId])
  @@index([sourceId])
  @@index([eventId])
}
