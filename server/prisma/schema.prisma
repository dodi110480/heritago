generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum GlobalRole {
  ADMIN
  USER
  GUEST
}

enum TreeAccessLevel {
  OWNER
  EDITOR
  VIEWER
  COMMENTER
}

enum Sex {
  M
  F
  X
  U
}

enum PrivacyLevel {
  PUBLIC
  FAMILY
  PRIVATE
}

enum FamilyRole {
  SPOUSE
  CHILD
  PARENT
}

enum MarriageType {
  CIVIL
  RELIGIOUS
  COMMON_LAW
  SAME_SEX
  UNKNOWN
}

enum PedigreeType {
  BIRTH
  ADOPTED
  FOSTER
  STEP
  SEALED
}

enum DatePrecision {
  EXACT
  ABOUT
  CALCULATED
  BEFORE
  AFTER
  BETWEEN
  RANGE
}

enum ConfidenceLevel {
  CERTAIN
  VERY_LIKELY
  LIKELY
  POSSIBLE
  UNLIKELY
}

enum ResearchStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum DnaTestProvider {
  ANCESTRY
  MYHERITAGE
  GEDMATCH
  TWENTY_THREE_AND_ME
  FAMILY_TREE_DNA
  LIVING_DNA
}

enum AssociationRole {
  GODPARENT
  WITNESS
  CLERGY
  EMPLOYER
  FRIEND
  OTHER
}

enum EntityType {
  PERSON
  FAMILY
  EVENT
  FACT
  SOURCE
  REPOSITORY
  MEDIA
  NOTE
  PLACE
  OTHER
}

//////////////////////////////////////////////////
// TREE
//////////////////////////////////////////////////

model Tree {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String?
  description String?
  isPublic    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chanDate    DateTime?

  persons       Person[]
  families      Family[]
  names         Name[]
  events        Event[]
  facts         Fact[]
  sources       Source[]
  repositories  Repository[]
  media         Media[]
  citations     Citation[]
  noteLinks     NoteLink[]
  mediaLinks    MediaLink[]
  associations  Association[]
  dnaMatches    DnaMatch[]
  dnaSegments   DnaSegment[]
  sharedNotes   SharedNote[]
  places        Place[]
  researchLogs  ResearchLog[]
  changeLogs    ChangeLog[]
  permissions   TreePermission[]

  @@index([isPublic])
}

//////////////////////////////////////////////////
// USER & PERMISSIONS
//////////////////////////////////////////////////

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  email      String?    @unique
  password   String?
  globalRole GlobalRole @default(USER)

  permissions  TreePermission[]
  researchLogs ResearchLog[]
  changeLogs   ChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TreePermission {
  id              String          @id @default(uuid())
  treeId          String
  tree            Tree            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  level           TreeAccessLevel
  privacyOverride Boolean?

  @@unique([treeId, userId])
  @@index([treeId])
}

//////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////

model Person {
  id            String       @id @default(uuid())
  gedcomId      String?
  sex           Sex?
  isLiving      Boolean      @default(false)
  privacyLevel  PrivacyLevel @default(PRIVATE)
  exid          String?

  treeId        String
  tree          Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)

  names         Name[]
  events        Event[]      @relation("PersonEvents")
  facts         Fact[]       @relation("PersonFacts")
  familyMembers FamilyMember[]

  associations   Association[] @relation("PersonAssociations")
  associatedWith Association[] @relation("AssociatedPerson")

  mediaLinks MediaLink[]
  noteLinks  NoteLink[]
  citations  Citation[]

  dnaMatches  DnaMatch[]   @relation("PersonDnaMatches")
  dnaMatchedBy DnaMatch[]  @relation("PersonDnaMatchCounterparty")
  dnaSegments DnaSegment[] @relation("PersonDnaSegments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@unique([treeId, gedcomId])
  @@index([treeId])
  @@index([treeId, isLiving])
  @@index([sex])
}

//////////////////////////////////////////////////
// FAMILY
//////////////////////////////////////////////////

model Family {
  id       String @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  familyMembers FamilyMember[]
  events        Event[] @relation("FamilyEvents")
  facts         Fact[]  @relation("FamilyFacts")

  mediaLinks MediaLink[]
  noteLinks  NoteLink[]
  citations  Citation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@unique([treeId, gedcomId])
  @@index([treeId])
}

//////////////////////////////////////////////////
// FAMILY MEMBER
//////////////////////////////////////////////////

model FamilyMember {
  id           String       @id @default(uuid())
  familyId     String
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId     String
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  role         FamilyRole?
  marriageType MarriageType?
  pedigreeType PedigreeType?
  sortOrder    Int @default(0)

  @@unique([familyId, personId])
  @@index([familyId])
  @@index([personId])
  @@index([familyId, role])
}

//////////////////////////////////////////////////
// NAME
//////////////////////////////////////////////////

model Name {
  id       String @id @default(uuid())

  treeId   String
  tree     Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  full      String
  given     String?
  surname   String?
  prefix    String?
  suffix    String?
  type      String?
  isPrimary Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([treeId])
  @@index([treeId, surname, given])
  @@index([treeId, isPrimary])
}

//////////////////////////////////////////////////
// EVENT
//////////////////////////////////////////////////

model Event {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  type String

  dateText  String?
  dateStart DateTime?
  dateEnd   DateTime?
  dateType  DatePrecision?

  sortDate  DateTime?
  sortOrder Int @default(0)

  placeId String?
  place   Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  description String?
  isNegative  Boolean @default(false)

  personId String?
  person   Person? @relation("PersonEvents", fields: [personId], references: [id], onDelete: Cascade)

  familyId String?
  family   Family? @relation("FamilyEvents", fields: [familyId], references: [id], onDelete: Cascade)

  citations  Citation[]
  mediaLinks MediaLink[]
  noteLinks  NoteLink[]
  associations Association[]

  @@index([treeId])
  @@index([treeId, sortDate])
  @@index([treeId, type, sortDate])
}

//////////////////////////////////////////////////
// FACT
//////////////////////////////////////////////////

model Fact {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  type String

  value     String?
  dateText  String?
  dateStart DateTime?
  dateEnd   DateTime?
  dateType  DatePrecision?

  sortOrder Int @default(0)

  placeId String?
  place   Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation("PersonFacts", fields: [personId], references: [id], onDelete: Cascade)

  familyId String?
  family   Family? @relation("FamilyFacts", fields: [familyId], references: [id], onDelete: Cascade)

  citations Citation[]

  @@index([treeId])
  @@index([treeId, type])
}

//////////////////////////////////////////////////
// PLACE
//////////////////////////////////////////////////

model Place {
  id     String @id @default(uuid())
  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  name          String
  historicNames String[]

  latitude     Float?
  longitude    Float?
  jurisdiction String?

  parentId String?
  parent   Place?  @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Place[] @relation("PlaceHierarchy")

  events Event[]
  facts  Fact[]
  associations Association[]

  @@unique([treeId, name, parentId])
  @@index([treeId])
}

//////////////////////////////////////////////////
// SOURCE / REPOSITORY
//////////////////////////////////////////////////

model Source {
  id       String @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  title       String
  shortTitle  String?
  author      String?
  publication String?

  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  citations  Citation[]
  mediaLinks MediaLink[]
  noteLinks  NoteLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@unique([treeId, gedcomId])
  @@index([treeId])
}

model Repository {
  id       String @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  name    String
  address String?
  phone   String?
  email   String?
  website String?

  sources Source[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@index([treeId])
}

//////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////

model Media {
  id       String @id @default(uuid())
  gedcomId String?

  treeId String
  tree   Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  title      String?
  filePath   String?
  remoteUrl  String?
  mimeType   String?
  mediaType  String?
  fileSize   Int?
  dimensions String?

  sortOrder Int @default(0)

  links     MediaLink[]
  citations Citation[]
  noteLinks NoteLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@index([treeId])
}

//////////////////////////////////////////////////
// CITATION
//////////////////////////////////////////////////

model Citation {
  id     String @id @default(uuid())

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  page       String?
  dateText   String?
  confidence ConfidenceLevel?

  personId      String?
  familyId      String?
  eventId       String?
  factId        String?
  mediaId       String?
  noteId        String?
  associationId String?

  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  family      Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fact        Fact?        @relation(fields: [factId], references: [id], onDelete: SetNull)
  media       Media?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  note        SharedNote?  @relation(fields: [noteId], references: [id], onDelete: SetNull)
  association Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([sourceId])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([factId])
  @@index([mediaId])
  @@index([noteId])
  @@index([associationId])
}

//////////////////////////////////////////////////
// SHARED NOTE
//////////////////////////////////////////////////

model SharedNote {
  id            String       @id @default(uuid())
  gedcomId      String?
  treeId        String
  tree          Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  text          String
  noteType      String?
  privacyLevel  PrivacyLevel @default(PRIVATE)
  researchStatus ResearchStatus @default(OPEN)
  sortOrder     Int          @default(0)

  links     NoteLink[]
  citations Citation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chanDate  DateTime?

  @@index([treeId])
  @@index([treeId, researchStatus])
  @@index([treeId, noteType])
}

//////////////////////////////////////////////////
// NOTE LINK
//////////////////////////////////////////////////

model NoteLink {
  id        String @id @default(uuid())
  treeId    String
  tree      Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  noteId    String
  note      SharedNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  personId  String?
  familyId  String?
  eventId   String?
  sourceId  String?
  mediaId   String?

  person    Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  family    Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  source    Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  media     Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  context   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([treeId])
  @@index([noteId])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([sourceId])
  @@index([mediaId])
}

//////////////////////////////////////////////////
// MEDIA LINK
//////////////////////////////////////////////////

model MediaLink {
  id        String @id @default(uuid())
  treeId    String
  tree      Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  mediaId   String
  media     Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  personId  String?
  familyId  String?
  eventId   String?
  sourceId  String?

  person    Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  family    Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  source    Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  role      String?
  caption   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([treeId])
  @@index([mediaId])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
  @@index([sourceId])
}

//////////////////////////////////////////////////
// ASSOCIATION
//////////////////////////////////////////////////

model Association {
  id                 String          @id @default(uuid())
  treeId             String
  tree               Tree            @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId           String
  associatedPersonId String
  person             Person          @relation("PersonAssociations", fields: [personId], references: [id], onDelete: Cascade)
  associated         Person          @relation("AssociatedPerson", fields: [associatedPersonId], references: [id], onDelete: Cascade)

  role               AssociationRole @default(OTHER)
  relationText       String?
  dateText           String?
  confidence         ConfidenceLevel?
  notes              String?

  eventId            String?
  placeId            String?
  event              Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  place              Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)

  citations          Citation[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([treeId, personId, associatedPersonId, role])
  @@index([treeId])
  @@index([personId])
  @@index([associatedPersonId])
  @@index([eventId])
  @@index([placeId])
}

//////////////////////////////////////////////////
// DNA
//////////////////////////////////////////////////

model DnaMatch {
  id                    String          @id @default(uuid())
  treeId                String
  tree                  Tree            @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId              String
  matchPersonId         String?
  person                Person          @relation("PersonDnaMatches", fields: [personId], references: [id], onDelete: Cascade)
  matchPerson           Person?         @relation("PersonDnaMatchCounterparty", fields: [matchPersonId], references: [id], onDelete: SetNull)

  provider              DnaTestProvider?
  totalCm               Float?
  largestSegmentCm      Float?
  segmentCount          Int?
  predictedRelationship String?
  confidence            ConfidenceLevel?
  testDate              DateTime?
  kitId                 String?

  segments              DnaSegment[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([personId, matchPersonId, provider])
  @@index([treeId])
  @@index([personId])
  @@index([matchPersonId])
  @@index([treeId, provider])
}

model DnaSegment {
  id             String          @id @default(uuid())
  treeId         String
  tree           Tree            @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId       String
  person         Person          @relation("PersonDnaSegments", fields: [personId], references: [id], onDelete: Cascade)

  matchId        String?
  match          DnaMatch?       @relation(fields: [matchId], references: [id], onDelete: SetNull)

  chromosome     String
  startPosition  Int
  endPosition    Int
  cm             Float
  snpCount       Int?
  provider       DnaTestProvider?
  build          String?
  isTriangulated Boolean         @default(false)

  createdAt      DateTime @default(now())

  @@index([treeId, chromosome])
  @@index([personId])
  @@index([matchId])
}

//////////////////////////////////////////////////
// RESEARCH / CHANGE LOG
//////////////////////////////////////////////////

model ResearchLog {
  id          String         @id @default(uuid())
  treeId      String
  tree        Tree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  status      ResearchStatus @default(OPEN)
  title       String
  description String?
  objective   String?
  result      String?
  nextStep    String?

  entityType  EntityType?
  entityId    String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([treeId])
  @@index([userId])
  @@index([entityType, entityId])
}

model ChangeLog {
  id         String       @id @default(uuid())
  treeId     String
  tree       Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     ChangeAction
  entityType EntityType
  entityId   String
  before     Json?
  after      Json?
  summary    String?
  reason     String?
  source     String?
  createdAt  DateTime @default(now())

  @@index([treeId, createdAt])
  @@index([treeId, action])
  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
}
