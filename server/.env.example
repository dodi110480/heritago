# Heritago backend - example environment.
#
# Copy to `server/.env` and adjust the values. `server/.env` itself is never committed.
#   cp server/.env.example server/.env

# Port the API listens on (nginx proxies /api to it, see docs/install.md).
PORT=3000

# PostgreSQL connection string (see docs/install.md step 2).
DATABASE_URL="postgresql://heritago:CHANGE_ME@127.0.0.1:5432/heritago?schema=public"

# Secret used to sign the JWTs - must be a long, random value.
# Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME"

NODE_ENV=production

# Public base URL of the application (used for links in e-mails).
APP_URL="https://heritago.example.org"

# Allowed CORS origins (comma separated).
CORS_ORIGIN="https://heritago.example.org"

# ---------------------------------------------------------------------------
# Auth cookies
# ---------------------------------------------------------------------------
# Cookies are marked `Secure` in production. A plain-HTTP deployment (e.g. an
# internal test server) must opt out explicitly, otherwise the browser drops the
# cookie and login does not stick.
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# E-mail (SMTP) - required for e-mail verification and password reset.
# Without MAIL_HOST mails are only logged to the console (development mode).
# ---------------------------------------------------------------------------
# MAIL_HOST=smtp.example.org
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=heritago@example.org
# MAIL_PASSWORD=CHANGE_ME
# MAIL_FROM="Heritago <heritago@example.org>"

# ---------------------------------------------------------------------------
# Bot protection / rate limiting (secure defaults apply without these)
# ---------------------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# UPLOAD_RATE_LIMIT_MAX=20
# UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Update check (Einstellungen -> System & Updates)
# ---------------------------------------------------------------------------
# Source is the GitHub repository this installation was cloned from. Without
# these values dodi110480/heritago is used.
GITHUB_OWNER="dodi110480"
GITHUB_REPO="heritago"

# Optional. The anonymous GitHub API allows only 60 requests per hour; a token
# raises that limit (and is required for a private repository). An invalid or
# expired token is ignored - the check then simply runs anonymously again.
# Create a fine-grained token with read-only access to "Contents" + "Metadata".
# GITHUB_TOKEN="github_pat_..."

# ---------------------------------------------------------------------------
# Automatic updates (optional - see docs/install.md section 7.3)
# ---------------------------------------------------------------------------
# HERITAGO_STATE_DIR=/var/lib/heritago
# HERITAGO_UPDATE_UNIT=heritago-update.service

# ---------------------------------------------------------------------------
# Initial admin account (optional - only used on the very first start)
# ---------------------------------------------------------------------------
# Without SEED_ADMIN_PASSWORD a random password is generated and written to the
# server log once.
# SEED_ADMIN_USERNAME=Dodi
# SEED_ADMIN_EMAIL=admin@heritago.org
# SEED_ADMIN_PASSWORD=CHANGE_ME
